# Frontend settings (Vite exposes VITE_ variables to the browser)
VITE_API_URL=http://localhost:5000/api
VITE_UPLOAD_BASE=http://localhost:5000

# Public contact details
VITE_PHONE=+917677666677
VITE_EMAIL=info@visafornation.com

# Admin pagination and chatbot refresh
VITE_ADMIN_PAGE_SIZE=10
VITE_ADMIN_CHATBOT_REFRESH_MS=15000
VITE_ADMIN_CHATBOT_CALL_LIMIT=100

# Content limits
VITE_BLOG_MAX_CONTENT_CHARS=3500
VITE_NEWS_MAX_CONTENT_CHARS=3500
VITE_BLOG_MAX_COUNT=30
VITE_NEWS_MAX_COUNT=30
VITE_PODCAST_MAX_COUNT=20
VITE_BANNER_MAX_COUNT=30

# Media upload limits
VITE_REEL_MAX_COUNT=30
VITE_REEL_MAX_SIZE_MB=200
VITE_REEL_MAX_DURATION_SECONDS=120
VITE_TESTIMONIAL_MAX_COUNT=30
VITE_TESTIMONIAL_MAX_SIZE_MB=200
VITE_TESTIMONIAL_MAX_DURATION_SECONDS=120
VITE_IMAGE_UPLOAD_MAX_SIZE_MB=10

# Review, team, award, and gallery limits
VITE_REVIEW_MAX_COUNT=20
VITE_REVIEW_MAX_MESSAGE_CHARS=500
VITE_TEAM_IMAGE_MAX_COUNT=40
VITE_AWARD_SECTION_MAX_COUNT=20
VITE_GALLERY_MAX_COUNT=15
VITE_MAX_GALLERY_IMAGES_PER_SECTION=15
